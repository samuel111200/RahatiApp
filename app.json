{
  "expo": {
    "name": "حكاية حركة",
    "slug": "hekaya-haraka",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "notification": {
      "icon": "./assets/images/character.png",
      "color": "#7C5CBF"
    },
    "scheme": "hekaya-haraka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahtyi.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج التطبيق إلى الميكروفون لإرسال الرسائل الصوتية",
        "NSCameraUsageDescription": "يحتاج التطبيق إلى الكاميرا لإرسال الصور",
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png"
      },
      "package": "com.rahtyi.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لإرسال الرسائل الصوتية"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/character.png",
          "color": "#7C5CBF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to your photos.",
          "savePhotosPermission": "Allow saving photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b72407ff-96b3-4597-9d7f-0f0623c302ec"
      }
    },
    "owner": "abdelrhman-ahmed"
  }
}
